# Copy to .env and fill in. Never commit .env.

# ---------- required ----------
# Postgres connection string (the Docker setup overrides this with its own database)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/secureexam?schema=public"
# Signs session cookies. Use a long random value (32+ characters)
JWT_SECRET=
# Public address of the app (used in links and OAuth redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Public sign-up is closed unless this is exactly "true"
ALLOW_PUBLIC_SIGNUP=
# Demo fill buttons on the sign-in page. They expose these passwords to every visitor: demos only
SHOW_DEMO_LOGINS=
DEMO_ADMIN_PASSWORD=
DEMO_EXAMINER_PASSWORD=
DEMO_CANDIDATE_PASSWORD=

# Optional: lets a scheduler call POST /api/cron/finalize (Authorization: Bearer <value>)
CRON_SECRET=

# ---------- seed accounts (pnpm run seed:admin / seed:roles) ----------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN2_EMAIL=
ADMIN2_PASSWORD=
ADMIN2_NAME=
# TEACHER* variables create examiner accounts, STUDENT* variables create candidates
TEACHER1_EMAIL=
TEACHER1_PASSWORD=
TEACHER1_NAME=
TEACHER2_EMAIL=
TEACHER2_PASSWORD=
TEACHER2_NAME=
STUDENT1_EMAIL=
STUDENT1_PASSWORD=
STUDENT1_NAME=
STUDENT2_EMAIL=
STUDENT2_PASSWORD=
STUDENT2_NAME=

# ---------- optional services: the core app works without all of these ----------
# Email (Resend)
RESEND_SECRET_KEY=
RESEND_FROM_EMAIL=
# File storage (Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_BUCKET=
# Instant updates (Pusher); polling is used without it
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
# Video meetings (100ms)
APP_ACCESS_KEY=
APP_SECRET_KEY=
MANAGEMENT_TOKEN=
TEMPLATE_ID=
# Text to speech and transcription (ElevenLabs)
ELEVENLABS_API_KEY=
# Google Calendar (OAuth web client)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Payments (Stripe test key)
STRIPE_SECRET_KEY=
# Content moderation service URL (see moderation-service/)
MODERATION_SERVICE_URL=
# Cloudflare Turnstile bot check on sign-in, password, support and email forms. Off while the secret is empty.
# The site key is public. Never commit the secret.
TURNSTILE_SITE_KEY=0x4AAAAAAGVgMjMShj__7XwQ
TURNSTILE_SECRET_KEY=
# Hostnames the widget may be solved on, comma separated (empty: the request's own host)
TURNSTILE_HOSTNAMES=
