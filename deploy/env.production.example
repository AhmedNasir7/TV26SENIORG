# The server's settings file: ~/secureexam/.env
# Create it once on the server (or copy a filled one there). It is never committed or sent by the pipeline.

# ---------- required ----------
# 32 or more random characters
JWT_SECRET=
# 16 or more letters, digits, - or _ (no other symbols)
POSTGRES_PASSWORD=
NEXT_PUBLIC_APP_URL=https://seniorgrade.site

# ---------- first administrator (used only while no administrator exists) ----------
ADMIN_EMAIL=
# at least 8 characters
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ---------- recommended ----------
ALLOW_PUBLIC_SIGNUP=false
CRON_SECRET=
# Reminder emails, minutes before the start, comma separated (default 1440,60 = a day and an hour).
# For a quick test use e.g. REMINDER_MINUTES=10,5,2,1
REMINDER_MINUTES=
# How often the server's timer runs, in minutes (default 1). Read by deploy/deploy.sh.
CRON_INTERVAL_MINUTES=
# Bot check. The site key is public; the secret comes from the Cloudflare Turnstile widget
TURNSTILE_SITE_KEY=0x4AAAAAAGVgMjMShj__7XwQ
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=seniorgrade.site

# ---------- optional services: leave empty to switch off ----------
RESEND_SECRET_KEY=
RESEND_FROM_EMAIL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_BUCKET=
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
# The browser's copy of these two is fixed when the image is built; the pipeline reads them from this file
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
APP_ACCESS_KEY=
APP_SECRET_KEY=
MANAGEMENT_TOKEN=
TEMPLATE_ID=
ELEVENLABS_API_KEY=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
STRIPE_SECRET_KEY=
MODERATION_SERVICE_URL=

# AI features (Groq). Add with: bash scripts/set-groq.sh
GROQ_API_KEY=
# Optional: another model name, and the most AI requests allowed per day
GROQ_MODEL=
AI_DAILY_LIMIT=200

# Needed to sign up an administrator (at least 8 characters). Empty: sign-up is closed.
ADMIN_SIGNUP_CODE=

# Live examinations (100ms). Recording needs the template subdomain from the 100ms dashboard
# (Templates > your template). Optional: HMS_STAFF_ROLE, HMS_CANDIDATE_ROLE, HMS_RECORDING_URL.
HMS_SUBDOMAIN=
